{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "complaint-route": {
        "ClusterId": "user-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/complaints/{**catch-all}"
        }
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "category-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "purchase-route": {
        "ClusterId": "order-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/purchases/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "order-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "rental-route": {
        "ClusterId": "order-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/rentals/{**catch-all}"
        }
      },
      "image-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/images/{**catch-all}"
        }
      },
      "product-image-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/product-images/{**catch-all}"
        }
      },
      "rent-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/rent/{**catch-all}"
        }
      },
      "product-rent-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/product-rents/{**catch-all}"
        }
      },
      "report-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "uploads-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        }
      },
      "review-route": {
        "ClusterId": "product-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "CorsPolicy": "AllowReactApp",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5104"
          }
        }
      }
    }
  }
}
